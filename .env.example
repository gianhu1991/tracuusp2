# --- Vercel Environment Variables ---
# Cach 3 (Vercel lau dai): Cloudflare + Node tren may server — HUONG-DAN-CLOUDFLARE-NODE.md
STORAGE_API_URL=https://luutru.ten-cua-ban.com/api
STORAGE_API_KEY=<storage-key.txt tren may server>
# Cach 2 tam (ngrok): STORAGE_API_URL=https://xxx.ngrok-free.dev/api
# Cach 2: Supabase cloud hoac Docker + tunnel — HUONG-DAN-VERCEL-MAY-CHU-DATA.md
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
NEXT_PUBLIC_SUPABASE_URL=https://tracuu-db.ten-cua-ban.com
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
ADMIN_PASSWORD=mat-khau-quan-tri-cua-ban
# Mã mở khóa Cài đặt / Báo cáo và upload Excel TB (cookie httpOnly). Không đặt = không bật khóa UI quản trị + upload TB.
UNLOCK_PASSWORD=
# ADMIN_UNLOCK_COOKIE_SECRET=...  (tùy chọn; ký cookie; mặc định suy ra từ UNLOCK_PASSWORD)
# ONE_BSS_AUTHORIZATION=Bearer ...  (tùy chọn; hoặc đổi token trên web mỗi ngày)
# Danh sách NV địa bàn cho form Đề xuất S2 (phân tách bằng dấu phẩy)
# NEXT_PUBLIC_S2_PROPOSAL_NV_LIST=Nguyễn Văn A,Trần Văn B

# --- Backend tra cứu (tùy chọn) ---
# BACKEND_URL=https://your-backend.railway.app
# AUTHORIZATION=Bearer your-token-here

# --- Local / GitHub (không commit) ---
# GITHUB_TOKEN=ghp_xxxxxxxx
